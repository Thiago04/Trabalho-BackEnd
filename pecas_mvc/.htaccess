RewriteEngine On
RewriteBase /pecas_mvc/

# Se o arquivo pedido existir fisicamente dentro de public/ (ex: imagem, CSS), serve direto
RewriteCond %{REQUEST_URI} ^/pecas_mvc/(.*)$
RewriteCond %{DOCUMENT_ROOT}/pecas_mvc/public/%1 -f
RewriteRule ^(.*)$ public/$1 [L]

# Caso contrário (rota, ação, arquivo inexistente), manda tudo para o front controller
RewriteRule ^(.*)$ public/index.php [L,QSA]
